{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "003-create-personalschedule-table",
        "author": "pconrad",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          { "not": { "tableExists": { "tableName": "personalschedule" } } }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "personalschedule",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "BIGINT",
                    "autoIncrement": true,
                    "constraints": { "nullable": false, "primaryKey": true }
                  }
                },
                {
                  "column": {
                    "name": "user_id",
                    "type": "BIGINT",
                    "constraints": {
                      "foreignKeyName": "fk_personalschedule_user_id",
                      "references": "users(id)"
                    }
                  }
                },
                { "column": { "name": "name", "type": "VARCHAR(255)" } },
                { "column": { "name": "description", "type": "VARCHAR(255)" } },
                { "column": { "name": "quarter", "type": "VARCHAR(255)" } }
              ]
            }
          }
        ]
      }
    }
  ]
}
