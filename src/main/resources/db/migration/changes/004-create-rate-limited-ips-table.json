{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "004-create-rate-limited-ips-table",
        "author": "pconrad",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          { "not": { "tableExists": { "tableName": "rate_limited_ips" } } }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "rate_limited_ips",
              "columns": [
                {
                  "column": {
                    "name": "ip_address",
                    "type": "VARCHAR(255)",
                    "constraints": { "nullable": false, "primaryKey": true }
                  }
                },
                { "column": { "name": "request_count", "type": "BIGINT" } },
                {
                  "column": {
                    "name": "last_request_at",
                    "type": "TIMESTAMP WITH TIME ZONE"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
