{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "008-create-enrollmentdatapoint-table",
        "author": "pconrad",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          { "not": { "tableExists": { "tableName": "enrollmentdatapoint" } } }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "enrollmentdatapoint",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "BIGINT",
                    "autoIncrement": true,
                    "constraints": { "nullable": false, "primaryKey": true }
                  }
                },
                { "column": { "name": "yyyyq", "type": "VARCHAR(255)" } },
                { "column": { "name": "enroll_cd", "type": "VARCHAR(255)" } },
                { "column": { "name": "course_id", "type": "VARCHAR(255)" } },
                { "column": { "name": "section", "type": "VARCHAR(255)" } },
                { "column": { "name": "enrollment", "type": "INT" } },
                { "column": { "name": "date_created", "type": "TIMESTAMP" } }
              ]
            }
          }
        ]
      }
    }
  ]
}
